// Reglas de seguridad de Cloud Firestore para BioAsistencia.
// NO se despliegan automáticamente: revísalas y publícalas desde la consola
// de Firebase (Firestore Database > Reglas) o con
//   firebase deploy --only firestore:rules
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    // El dueño del correo abrió el enlace de verificación. Se exige a
    // estudiantes y docentes para operar (no para crear el perfil, que se
    // guarda justo al registrarse, antes de poder verificar).
    function verified() {
      return signedIn() && request.auth.token.email_verified == true;
    }

    function institutionalEmail() {
      return request.auth.token.email.matches('.*@udla[.]edu[.]co$');
    }

    // Docente autorizado: su correo está en la lista que administra la
    // institución (teachers/{correo}, solo editable desde la consola) y lo
    // verificó. El rol elegido en la interfaz NO concede permisos.
    function teacherListed() {
      return exists(/databases/$(database)/documents/teachers/$(request.auth.token.email))
        && get(/databases/$(database)/documents/teachers/$(request.auth.token.email)).data.get('active', true) == true;
    }

    function isTeacher() {
      return signedIn()
        && request.auth.token.email_verified == true
        && teacherListed();
    }

    function courseDoc(courseId) {
      return get(/databases/$(database)/documents/courses/$(courseId));
    }

    function sessionDoc(sessionId) {
      return get(/databases/$(database)/documents/sessions/$(sessionId));
    }

    // Docente dueño de la asignatura.
    function teachesCourse(courseId) {
      return isTeacher()
        && courseDoc(courseId).data.get('teacherUid', '') == request.auth.uid;
    }

    // Lista de docentes autorizados. Cada usuario solo puede consultar su
    // propio correo; nadie la modifica desde la app.
    match /teachers/{email} {
      allow get: if signedIn() && request.auth.token.email == email;
      allow list, write: if false;
    }

    // Perfil académico: solo su dueño puede leerlo y crearlo.
    match /users/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow create: if signedIn()
        && request.auth.uid == uid
        && institutionalEmail()
        && request.resource.data.keys().hasOnly(
             ['name', 'email', 'role', 'code', 'faculty', 'bleEnabled', 'createdAt'])
        && request.resource.data.email == request.auth.token.email
        && (request.resource.data.role == 'student'
            || (request.resource.data.role == 'teacher' && teacherListed()))
        && request.resource.data.code is string
        && request.resource.data.code.matches('^[0-9]{5,15}$')
        // El código debe quedar reservado para este mismo usuario en la
        // misma operación (escritura por lotes).
        && getAfter(/databases/$(database)/documents/codes/$(request.resource.data.code)).data.uid == uid;
      // El usuario solo puede editar sus datos complementarios y
      // preferencias; nunca rol, código, correo ni facultad.
      allow update: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['program', 'semester', 'campus', 'settings', 'bleEnabled'])
        && (!('program' in request.resource.data) || request.resource.data.program is string)
        && (!('campus' in request.resource.data) || request.resource.data.campus is string)
        && (!('semester' in request.resource.data)
            || (request.resource.data.semester is int
                && request.resource.data.semester >= 1
                && request.resource.data.semester <= 20))
        && (!('settings' in request.resource.data) || request.resource.data.settings is map)
        && request.resource.data.bleEnabled is bool;
      allow delete: if false;
    }

    // Índice código -> correo para iniciar sesión con el código.
    // Lectura individual pública (se consulta antes de iniciar sesión);
    // no se permite listar la colección.
    // Riesgo aceptado: quien conozca un código válido puede ver su correo.
    match /codes/{code} {
      allow get: if true;
      allow list: if false;
      // "create" solo aplica si el documento no existe: garantiza unicidad.
      allow create: if signedIn()
        && institutionalEmail()
        && code.matches('^[0-9]{5,15}$')
        && request.resource.data.keys().hasOnly(['email', 'uid'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.email == request.auth.token.email;
      allow update, delete: if false;
    }

    // ----------------------------------------------------------------
    // Matrículas. El estudiante se identifica por su correo institucional
    // (minúsculas), que es lo que comparten la lista oficial y la cuenta.

    function myEmail() {
      return request.auth.token.email.lower();
    }

    function enrollmentPath(courseId, email) {
      return /databases/$(database)/documents/enrollments/$(courseId + '_' + email);
    }

    // Estado de la matrícula del usuario en la asignatura ('' si no tiene).
    function myEnrollmentStatus(courseId) {
      return exists(enrollmentPath(courseId, myEmail()))
        ? get(enrollmentPath(courseId, myEmail())).data.status
        : '';
    }

    // Matriculado ahora (puede registrar asistencia).
    function activeIn(courseId) {
      return verified() && myEnrollmentStatus(courseId) == 'active';
    }

    function validCourse(d) {
      return d.keys().hasOnly(['name', 'period', 'group', 'teacherName',
               'teacherUid', 'room', 'building', 'code', 'schedule',
               'maxAbsences', 'registrationMinutes', 'createdAt'])
        && d.teacherUid == request.auth.uid
        && d.name is string && d.name.size() > 0 && d.name.size() <= 120
        && d.period is string && d.period.size() <= 20
        && d.schedule is list && d.schedule.size() <= 14
        && (d.maxAbsences == null || (d.maxAbsences is int && d.maxAbsences >= 0))
        && d.registrationMinutes is int
        && d.registrationMinutes > 0 && d.registrationMinutes <= 240;
    }

    // Asignaturas: un grupo de una materia con un docente. El docente lee
    // las suyas (where teacherUid == uid); el estudiante, cada una por id si
    // tiene una matrícula visible (activa, invitada, cancelada o retirada).
    match /courses/{courseId} {
      allow read: if signedIn()
        && ((resource == null && verified())
            || resource.data.get('teacherUid', '') == request.auth.uid
            || (verified()
                && myEnrollmentStatus(courseId) in ['active', 'invited', 'withdrawn', 'removed']));
      allow create: if isTeacher()
        && validCourse(request.resource.data)
        && request.resource.data.createdAt == request.time;
      allow update: if isTeacher()
        && resource.data.get('teacherUid', '') == request.auth.uid
        && validCourse(request.resource.data)
        && request.resource.data.get('createdAt', null) == resource.data.get('createdAt', null);
      allow delete: if isTeacher()
        && resource.data.get('teacherUid', '') == request.auth.uid;
    }

    function validEnrollmentData(d) {
      return d.code is string && d.code.matches('^[0-9]{5,15}$')
        && d.name is string && d.name.size() > 0 && d.name.size() <= 120
        && d.program is string && d.program.size() <= 120
        && d.source in ['import', 'manual']
        && d.teacherSeen is bool;
    }

    // Dueño de la asignatura según el estado al terminar el lote: permite
    // crear la asignatura y su lista en la misma operación.
    function teachesCourseAfter(courseId) {
      return isTeacher()
        && getAfter(/databases/$(database)/documents/courses/$(courseId)).data.get('teacherUid', '') == request.auth.uid;
    }

    // Cambios de estado que puede hacer el docente.
    function teacherTransition(from, to) {
      return (from in ['invited', 'removed'] && to == 'active')
        || (from in ['declined', 'withdrawn', 'removed'] && to == 'invited')
        || (from in ['active', 'invited'] && to == 'removed');
    }

    // Matrícula: id "{courseId}_{correo}". El docente dueño la crea (activa
    // si viene de una lista importada; invitación si la agrega a mano), la
    // actualiza y la borra al eliminar la asignatura. El estudiante solo lee
    // la suya y solo puede aceptar/rechazar la invitación o cancelar.
    match /enrollments/{enrollmentId} {
      allow read: if signedIn()
        && ((resource.data.teacherUid == request.auth.uid && isTeacher())
            || (verified() && resource.data.email == myEmail()));

      allow create: if teachesCourseAfter(request.resource.data.courseId)
        && request.resource.data.keys().hasOnly(
             ['courseId', 'teacherUid', 'email', 'code', 'name', 'program',
              'status', 'source', 'createdAt', 'statusAt', 'teacherSeen'])
        && request.resource.data.teacherUid == request.auth.uid
        && request.resource.data.email is string
        && request.resource.data.email.matches('^[^@ ]+@udla[.]edu[.]co$')
        && request.resource.data.email == request.resource.data.email.lower()
        && enrollmentId == request.resource.data.courseId + '_' + request.resource.data.email
        && validEnrollmentData(request.resource.data)
        && ((request.resource.data.source == 'import' && request.resource.data.status == 'active')
            || (request.resource.data.source == 'manual' && request.resource.data.status == 'invited'))
        && request.resource.data.createdAt == request.time
        && request.resource.data.statusAt == request.time;

      // Docente: datos de la lista, aviso visto y transiciones permitidas.
      allow update: if resource.data.teacherUid == request.auth.uid
        && teachesCourse(resource.data.courseId)
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['code', 'name', 'program', 'source', 'teacherSeen', 'status', 'statusAt'])
        && validEnrollmentData(request.resource.data)
        && (request.resource.data.diff(resource.data).affectedKeys().hasAny(['status'])
            ? (teacherTransition(resource.data.status, request.resource.data.status)
               && request.resource.data.statusAt == request.time)
            : !request.resource.data.diff(resource.data).affectedKeys().hasAny(['statusAt']));

      // Estudiante: aceptar o rechazar la invitación, o cancelar.
      allow update: if verified()
        && resource.data.email == myEmail()
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['status', 'statusAt', 'teacherSeen'])
        && request.resource.data.statusAt == request.time
        && request.resource.data.teacherSeen == false
        && ((resource.data.status == 'invited'
             && request.resource.data.status in ['active', 'declined'])
            || (resource.data.status == 'active'
                && request.resource.data.status == 'withdrawn'));

      allow delete: if resource.data.teacherUid == request.auth.uid && isTeacher();
    }

    // Sesiones de asistencia. Lectura para usuarios verificados (solo
    // contienen asignatura, estado y horas). El docente dueño de la
    // asignatura las abre (con una ventana de registro de hasta 4 h) y las
    // finaliza; no se pueden reabrir ni borrar.
    match /sessions/{sessionId} {
      allow read: if verified();
      allow create: if teachesCourse(request.resource.data.courseId)
        && request.resource.data.keys().hasOnly(
             ['courseId', 'teacherUid', 'status', 'startsAt', 'endsAt'])
        && request.resource.data.teacherUid == request.auth.uid
        && request.resource.data.status == 'open'
        && request.resource.data.startsAt == request.time
        && request.resource.data.endsAt is timestamp
        && request.resource.data.endsAt > request.time
        && request.resource.data.endsAt <= request.time + duration.value(4, 'h');
      allow update: if resource.data.teacherUid == request.auth.uid
        && teachesCourse(resource.data.courseId)
        && resource.data.status == 'open'
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['status', 'closedAt'])
        && request.resource.data.status == 'closed'
        && request.resource.data.closedAt == request.time;
      allow delete: if false;
    }

    // Un celular registra a un solo estudiante por sesión.
    // id = "{sessionId}_{huella}" (SHA-256 del identificador del celular).
    // Se crea en el mismo lote que la asistencia del estudiante; como
    // "create" solo funciona si no existe, un segundo estudiante en el mismo
    // celular y la misma sesión es rechazado. La lectura individual sirve
    // para que la app explique el rechazo; nadie puede listarla.
    match /sessionDevices/{deviceId} {
      allow get: if verified();
      allow list, update, delete: if false;
      allow create: if verified()
        && request.resource.data.keys().hasOnly(['email', 'sessionId', 'createdAt'])
        && request.resource.data.email == myEmail()
        && request.resource.data.sessionId is string
        && request.resource.data.sessionId.matches('^[A-Za-z0-9]+$')
        && deviceId.matches('^' + request.resource.data.sessionId + '_[0-9a-f]{64}$')
        && request.resource.data.createdAt == request.time
        && existsAfter(/databases/$(database)/documents/attendance/$(request.resource.data.sessionId + '_' + myEmail()));
    }

    // Asistencias: id = "{sessionId}_{correo}" => una por estudiante y sesión.
    // - El estudiante la crea con su matrícula activa, la sesión abierta y
    //   dentro de su ventana (endsAt), desde un celular que no haya
    //   registrado a otro estudiante en la sesión (sessionDevices).
    // - El docente dueño puede añadir una asistencia manual (excepción) de
    //   un estudiante matriculado, aunque todavía no tenga cuenta.
    // El estudiante lee las suyas y el docente las de sus asignaturas.
    match /attendance/{recordId} {
      allow read: if signedIn()
        && ((verified() && resource.data.email == myEmail())
            || (resource.data.get('teacherUid', '') == request.auth.uid && isTeacher()));
      allow create: if signedIn()
        && request.resource.data.email is string
        && recordId == request.resource.data.sessionId + '_' + request.resource.data.email
        && request.resource.data.registeredAt == request.time
        && sessionDoc(request.resource.data.sessionId).data.courseId == request.resource.data.courseId
        && request.resource.data.teacherUid == courseDoc(request.resource.data.courseId).data.get('teacherUid', '')
        && (
          // Registro del estudiante durante la sesión.
          (request.resource.data.keys().hasOnly(
              ['email', 'studentUid', 'courseId', 'sessionId', 'registeredAt',
               'teacherUid', 'method', 'deviceKey'])
            && request.resource.data.method == 'session'
            && request.resource.data.email == myEmail()
            && request.resource.data.studentUid == request.auth.uid
            && request.resource.data.deviceKey is string
            && request.resource.data.deviceKey.matches('^[0-9a-f]{64}$')
            && activeIn(request.resource.data.courseId)
            && sessionDoc(request.resource.data.sessionId).data.status == 'open'
            && request.time < sessionDoc(request.resource.data.sessionId).data.get('endsAt', request.time + duration.value(1, 'd'))
            && getAfter(/databases/$(database)/documents/sessionDevices/$(request.resource.data.sessionId + '_' + request.resource.data.deviceKey)).data.email == myEmail())
          ||
          // Excepción registrada por el docente.
          (request.resource.data.keys().hasOnly(
              ['email', 'courseId', 'sessionId', 'registeredAt', 'teacherUid', 'method'])
            && request.resource.data.method == 'manual'
            && teachesCourse(request.resource.data.courseId)
            && get(enrollmentPath(request.resource.data.courseId, request.resource.data.email)).data.status == 'active')
        );
      allow update, delete: if false;
    }

    // Revisión de inasistencias por el docente (justificada / confirmada).
    // id = "{sessionId}_{correo}".
    match /justifications/{id} {
      allow read: if signedIn()
        && ((verified() && resource.data.email == myEmail())
            || (resource.data.teacherUid == request.auth.uid && isTeacher()));
      allow create, update: if teachesCourse(request.resource.data.courseId)
        && request.resource.data.keys().hasOnly(
             ['sessionId', 'courseId', 'email', 'teacherUid', 'status', 'updatedAt'])
        && id == request.resource.data.sessionId + '_' + request.resource.data.email
        && request.resource.data.teacherUid == request.auth.uid
        && request.resource.data.status in ['justified', 'confirmed']
        && request.resource.data.updatedAt == request.time
        && sessionDoc(request.resource.data.sessionId).data.courseId == request.resource.data.courseId
        && exists(enrollmentPath(request.resource.data.courseId, request.resource.data.email));
      allow delete: if false;
    }

    // Reportes de incidencias para el docente. Los crea el estudiante con
    // matrícula activa (o que canceló); el docente de la asignatura los
    // consulta. No se editan.
    match /incidents/{incidentId} {
      allow create: if verified()
        && request.resource.data.keys().hasOnly(
             ['studentUid', 'email', 'courseId', 'sessionId', 'message', 'createdAt', 'teacherUid'])
        && request.resource.data.studentUid == request.auth.uid
        && request.resource.data.email == myEmail()
        && request.resource.data.message is string
        && request.resource.data.message.size() <= 500
        && request.resource.data.createdAt == request.time
        && request.resource.data.get('teacherUid', '') == courseDoc(request.resource.data.courseId).data.get('teacherUid', '')
        && myEnrollmentStatus(request.resource.data.courseId) in ['active', 'withdrawn'];
      allow read: if signedIn()
        && resource.data.get('teacherUid', '') == request.auth.uid
        && isTeacher();
      allow update, delete: if false;
    }
  }
}
